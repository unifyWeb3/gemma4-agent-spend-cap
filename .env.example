# The primary arm. Google AI Studio serves Gemma 4 through its OpenAI
# compatible surface. Put your own key here.
GOOGLE_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# Optional fallback. The free Gemma 4 endpoints on OpenRouter answered 429
# on every attempt on 2026-11-05.
OPENROUTER_API_KEY=

# Optional. The shared gap between requests, in milliseconds. 3000 by
# default. It exists because AI Studio applies a per project request limit.
GEMINI_MIN_GAP_MS=3000
